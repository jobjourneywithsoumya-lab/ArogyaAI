{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "functions": {
    "api/auth/register.js": { "maxDuration": 30 },
    "api/auth/login.js": { "maxDuration": 30 },
    "api/health.js": { "maxDuration": 10 },
    "api/index.js": { "maxDuration": 60, "memory": 1024 },
    "api/cron/reminders.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 7 * * *"
    }
  ]
}
