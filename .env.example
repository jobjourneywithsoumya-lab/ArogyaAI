# MongoDB (optional — uses JSON files if not set)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/arogyaai

# JWT
JWT_SECRET=your_long_random_secret
JWT_EXPIRE=7d

# Email (Gmail app password for real emails)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# SMS via Twilio (optional — logs to console in demo mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App
APP_NAME=ArogyaAI
PORT=4000
NODE_ENV=production

# Frontend URL (Vercel)
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app
VITE_API_BASE_URL=https://your-app.vercel.app

# Vercel Cron (generate random string)
CRON_SECRET=your_cron_secret_here
